{
  "_readme": [
    "网页搜索源配置。复制成 web_search_api.json 再填。",
    "凭证【只写环境变量名】，值放在 .env 里，不要写进这个文件。",
    "下面给了三个常见形态，按你实际买的接口留一份、删掉其余的即可。"
  ],

  "_example_bocha": {
    "说明": "博查 Web Search（POST + JSON body + Bearer 头）",
    "endpoint": "https://api.bochaai.com/v1/web-search",
    "method": "POST",
    "body_format": "json",
    "params": {"query_key": "query", "count_key": "count"},
    "extra_params": {"summary": true, "freshness": "oneYear"},
    "auth": {"type": "header", "key": "Authorization", "prefix": "Bearer",
             "value_env": "TRAVELWISE_SEARCH_TOKEN"},
    "response": {
      "list_path": "data.webPages.value",
      "field_map": {"title": "name", "snippet": "snippet", "url": "url"}
    }
  },

  "_example_serper": {
    "说明": "Serper.dev（POST + JSON body + X-API-KEY 头）",
    "endpoint": "https://google.serper.dev/search",
    "method": "POST",
    "body_format": "json",
    "params": {"query_key": "q", "count_key": "num"},
    "extra_params": {"gl": "cn", "hl": "zh-cn"},
    "auth": {"type": "header", "key": "X-API-KEY", "prefix": "",
             "value_env": "TRAVELWISE_SEARCH_TOKEN"},
    "response": {
      "list_path": "organic",
      "field_map": {"title": "title", "snippet": "snippet", "url": "link"}
    }
  },

  "_example_query_auth": {
    "说明": "把 key 放在 query string 里的接口（GET）",
    "endpoint": "https://example-search.com/api/search",
    "method": "GET",
    "body_format": "query",
    "params": {"query_key": "keyword", "count_key": "size"},
    "auth": {"type": "query", "key": "appcode",
             "value_env": "TRAVELWISE_SEARCH_TOKEN"},
    "response": {
      "list_path": "result.items",
      "field_map": {"title": "title", "snippet": "desc", "url": "link"}
    }
  },

  "endpoint": "",
  "method": "POST",
  "body_format": "json",
  "params": {"query_key": "query", "count_key": "count"},
  "extra_params": {},
  "auth": {"type": "header", "key": "Authorization", "prefix": "Bearer",
           "value_env": "TRAVELWISE_SEARCH_TOKEN"},
  "response": {
    "list_path": "data.webPages.value",
    "field_map": {"title": "name", "snippet": "snippet", "url": "url"}
  }
}
